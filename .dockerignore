# ===== 构建上下文排除项（保持镜像精简）=====
.git
.gitattributes
.github
.hermes

# 虚拟环境（容器内重建）
.venv
venv
env

# Python 缓存
__pycache__
**/__pycache__
*.py[cod]
*.egg-info

# 测试覆盖率 / 旧发布副本
htmlcov
.coverage
KHunter-1.6.0

# 运行期产物（容器内由 compose 挂载宿主目录，保证持久化）
logs
reports

# 数据库与日志（首次启动由 db_initializer 重建）
*.db
*.db-shm
*.db-wal
*.sqlite
*.log

# 本地敏感配置（含 tushare token），不进镜像，运行期由 compose 挂载 ./config 提供
config/tushare_config.json

# 宿主平台杂物
desktop.ini
Thumbs.db
.DS_Store

# 部署编排文件本身无需进镜像
Dockerfile
docker-compose.yml
.dockerignore
DOCKER-DEPLOY.md
